# ---------------------------------------------------------------------------
# Cotorra configuration. Copy to .env and edit.
#
#   cp .env.example .env
#   docker compose up
#
# Every value below has a working default. The ONLY one you need for real
# speech recognition is GEMINI_API_KEY.
# ---------------------------------------------------------------------------

# --- engine ----------------------------------------------------------------
# gemini : Gemini multimodal — transcription + every translation in one call.
# local  : faster-whisper + Gemma via Ollama. No internet, no API key.
# mock   : scripted captions. No credentials. Use it to try the UI and to
#          load-test the fan-out. Captions are flagged as demo in every UI.
COTORRA_ENGINE=mock

# Get one at https://aistudio.google.com/apikey
#
# IMPORTANT: a FREE-TIER key allows roughly 15-20 requests PER DAY per model.
# One hour of captioning needs 400-900. The free tier is enough to prove the
# key works (`cotorra doctor --live`) and nothing else — enable billing before
# an event. Captioning 30 talks costs under US$11. See docs/engines.md.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- or use Vertex AI instead of AI Studio ---------------------------------
# Same models, same code path, but quota is per MINUTE instead of per day, and
# this is where Google Cloud credits (hackathon, startup, GDP) actually apply.
# Needs a GCP project with billing and Application Default Credentials:
#     gcloud auth application-default login
# On Cloud Run none of this is needed: the service account authenticates by
# itself. See deploy/README.md.
GEMINI_USE_VERTEX=false
GCP_PROJECT=
GCP_LOCATION=us-central1
# 0 = no thinking tokens. For verbatim transcription there is nothing to think
# about, and thinking is pure added latency. Raise it only if you are
# experimenting with heavily accented or noisy audio.
GEMINI_THINKING_BUDGET=0

# Two different clocks. The API refuses an HTTP deadline under 10 s, but live
# captioning wants to abandon a call much sooner than that, so Cotorra gives
# the transport the legal minimum and enforces these itself.
#   TIMEOUT_S  = per attempt
#   DEADLINE_S = the whole utterance, retries included. Past it the utterance
#                is dropped, because captions publish in order and a doomed
#                retry holds up every line behind it.
GEMINI_TIMEOUT_S=8
GEMINI_DEADLINE_S=10
# Longest 429 backoff worth taking before giving up on an utterance.
GEMINI_MAX_RETRY_WAIT_S=2

# --- local engine (COTORRA_ENGINE=local) -----------------------------------
LOCAL_WHISPER_MODEL=small
LOCAL_WHISPER_DEVICE=auto
LOCAL_WHISPER_COMPUTE_TYPE=int8
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# --- server ----------------------------------------------------------------
HOST=0.0.0.0
PORT=8080
# Shown to the audience on the ops panel so people can find the captions page.
PUBLIC_URL=

# --- auth ------------------------------------------------------------------
# Empty ADMIN_TOKEN leaves the control API open. Fine on a laptop, NOT fine on
# a machine reachable from the venue network. Set it before the doors open.
ADMIN_TOKEN=
# Shared secret between the gateway and its workers.
WORKER_TOKEN=change-me-before-the-event

# --- scale -----------------------------------------------------------------
# Overlapping model calls per session. Higher = smoother under bursty speech,
# more concurrent API usage.
WORKER_CONCURRENCY=3
# Safety rail: refuse to spawn more workers than one host can carry.
MAX_LOCAL_WORKERS=12
# Set this to run several gateway replicas behind a load balancer. Without it
# Cotorra runs happily on a single process.
REDIS_URL=

# --- latency / segmentation ------------------------------------------------
# Emit interim captions mid-sentence. Roughly halves perceived delay and adds
# ~40-60% to model cost. Turn off for cost-sensitive events.
PARTIALS=true
PARTIAL_INTERVAL_MS=1800
# Never make the audience wait longer than this for a caption, even if the
# speaker does not pause.
MAX_SEGMENT_MS=7000
SILENCE_MS=420
MIN_SEGMENT_MS=900

# --- cost model ------------------------------------------------------------
# USD per 1M tokens, used for the live cost counter on the ops panel.
# Check current rates at https://ai.google.dev/pricing and update these.
PRICE_AUDIO_IN=1.00
PRICE_TEXT_IN=0.30
PRICE_TEXT_OUT=2.50
